<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <title>TechNews</title>
    <link rel='stylesheet' href='main.css'>
</head>
<body>
    <header>
        <section class="Logo">TechNews</section>

        <section class="Navigation">
            <span>Home</span>
            <span>World</span>
            <span>Lifestyle</span>
        </section>

        <section class="Search">
            <img src="search-interface-symbol (1).png" alt="Logo">
            <input type="search" placeholder="Search">
        </section>
    </header>

    <main>
        <section class="Featured News">
            <article class="Left">
                <div><img src="download.jpg" alt="Apple"></div>
                <div>Aplle Unveils</div>
                <button>Read more</button>
            </article>
        </section>

        <section class="Latest News">
            <div>Latest News</div>
            <article>
                <div>
                    <img src="images.jpg" alt="">
                    <div>Business</div>
                </div>
            </article>

            <article>
                <div>
                    <img src="download (1).jpg" alt="">
                    <div>Health</div>
                </div>
            </article>

            <article>
                <div>
                    <div><img src="download.png" alt=""></div>
                    <div>Lifestyle</div>
                </div>
            </article>
        </section>

        <aside class="Popular news">
            <div>Popular News</div>
            <div>
                <img src="" alt="">
                <div>New AI</div>
            </div>
        </aside>
    </main>
    
    <footer>
        <div class="Logo2">TechNews</div>
        <div class="About">
            <span>About</span>
            <span>Content</span>
            <span>Privacy</span>
            <span>Terms</span>
        </div>
        <div class="Social">Social media</div>
    </footer>
</body>
</html>
